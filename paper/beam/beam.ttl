# BEAM description of the Steam Review Translator (generated by make_beam.py).
@prefix beam: <http://w3id.org/beam/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix res:  <http://example.org/steam-review-translator/> .

# system-wide
res:SteamReviewTranslator a beam:System ;
    rdfs:label "Steam Review Translator" ;
    beam:description """Turns a batch of user reviews of one game into a sentiment distribution (Task 1), an aspect table with mention frequency and dominant polarity (Task 2) and a short meta-review (Task 3).""" ;
    beam:context """Course project (IF5153, ITB). Intended for players deciding whether to buy a game and for developers tracking feedback; offline demonstration on Steam and Metacritic reviews, English only, not deployed.""" ;
    beam:hasResource res:batchReviews , res:t1_trainData , res:t1_model , res:t1_labels , res:t1_distribution , res:t2_sample , res:t2_llm , res:t2_labeled , res:t2_model , res:t2_sentences , res:t2_pairs , res:aspectTable , res:t3_gameWikiSum , res:t3_trainInputs , res:t3_model , res:t3_input , res:t3_metaReview ;
    beam:hasProcess res:t1_training , res:t1_inference , res:t1_aggregate , res:t2_annotation , res:t2_training , res:t2_split , res:t2_inference , res:t2_aggregate , res:t3_prepTrain , res:t3_training , res:t3_prepInput , res:t3_inference ;
    beam:hasAgent res:t2_annotator ;
    beam:contain res:Task1 , res:Task2 , res:Task3 .

# containers (one per task)
res:Task1 a beam:Container ;
    rdfs:label "Task 1 -- Batch Sentiment Aggregation" ;
    beam:contain res:batchReviews , res:t1_trainData , res:t1_training , res:t1_model , res:t1_inference , res:t1_labels , res:t1_aggregate , res:t1_distribution .

res:Task2 a beam:Container ;
    rdfs:label "Task 2 -- Aspect-Based Opinion Mining (sentence-level ABSA)" ;
    beam:contain res:batchReviews , res:t2_sample , res:t2_annotator , res:t2_llm , res:t2_annotation , res:t2_labeled , res:t2_training , res:t2_model , res:t2_split , res:t2_sentences , res:t2_inference , res:t2_pairs , res:t2_aggregate , res:aspectTable .

res:Task3 a beam:Container ;
    rdfs:label "Task 3 -- Meta-Review Generation (multi-document summarization)" ;
    beam:contain res:batchReviews , res:aspectTable , res:t3_gameWikiSum , res:t3_prepTrain , res:t3_trainInputs , res:t3_training , res:t3_model , res:t3_prepInput , res:t3_input , res:t3_inference , res:t3_metaReview .

# resources
res:batchReviews a beam:Data ;
    rdfs:label "Batch of reviews of one game (input)" ;
    beam:usedBy res:t1_inference , res:t2_split , res:t3_prepInput .

res:t1_trainData a beam:Data ;
    rdfs:label "Metacritic user reviews (train), label from user score" ;
    beam:usedBy res:t1_training .

res:t1_model a beam:StatisticalModel ;
    rdfs:label "RoBERTa-base (S4)" ;
    beam:usedBy res:t1_inference .

res:t1_labels a beam:Symbol ;
    rdfs:label "Sentiment label per review (pos / neg / neu)" ;
    beam:usedBy res:t1_aggregate .

res:t1_distribution a beam:Symbol ;
    rdfs:label "Sentiment distribution + dominant label (output)" .

res:t2_sample a beam:Data ;
    rdfs:label "Sampled Steam review sentences (7,002; 13 games)" ;
    beam:usedBy res:t2_annotation .

res:t2_llm a beam:StatisticalModel ;
    rdfs:label "Claude Opus (LLM annotator)" ;
    beam:usedBy res:t2_annotation .

res:t2_labeled a beam:Data ;
    rdfs:label "Labeled sentences (train / val / test by game)" ;
    beam:usedBy res:t2_training .

res:t2_model a beam:StatisticalModel ;
    rdfs:label "RoBERTa-base + LoRA, 11 aspect heads" ;
    beam:usedBy res:t2_inference .

res:t2_sentences a beam:Data ;
    rdfs:label "Review sentences" ;
    beam:usedBy res:t2_inference .

res:t2_pairs a beam:Symbol ;
    rdfs:label "(aspect, polarity) pairs per sentence" ;
    beam:usedBy res:t2_aggregate .

res:aspectTable a beam:Symbol ;
    rdfs:label "Aspect table: frequency + polarity per aspect (output)" ;
    beam:usedBy res:t3_prepInput .

res:t3_gameWikiSum a beam:Data ;
    rdfs:label "GameWikiSum: game reviews + Wikipedia summaries" ;
    beam:usedBy res:t3_prepTrain .

res:t3_trainInputs a beam:Data ;
    rdfs:label "Serialized inputs: aspect prefix + text -> summary" ;
    beam:usedBy res:t3_training .

res:t3_model a beam:StatisticalModel ;
    rdfs:label "BART-base + aspect prefix (E2)" ;
    beam:usedBy res:t3_inference .

res:t3_input a beam:Data ;
    rdfs:label "Aspect prefix + selected review text" ;
    beam:usedBy res:t3_inference .

res:t3_metaReview a beam:Data ;
    rdfs:label "Meta-review (output)" .

# processes
res:t1_training a beam:Train ;
    rdfs:label "Fine-tuning" ;
    beam:produce res:t1_model .

res:t1_inference a beam:Infer ;
    rdfs:label "Inference (per review)" ;
    beam:produce res:t1_labels .

res:t1_aggregate a beam:Transform ;
    rdfs:label "Aggregate (class shares)" ;
    beam:produce res:t1_distribution .

res:t2_annotation a beam:Engineer ;
    rdfs:label "LLM-assisted annotation (aspect, polarity)" ;
    beam:produce res:t2_labeled .

res:t2_training a beam:Train ;
    rdfs:label "LoRA fine-tuning" ;
    beam:produce res:t2_model .

res:t2_split a beam:Transform ;
    rdfs:label "Sentence splitting (spaCy)" ;
    beam:produce res:t2_sentences .

res:t2_inference a beam:Infer ;
    rdfs:label "Inference (per sentence)" ;
    beam:produce res:t2_pairs .

res:t2_aggregate a beam:Transform ;
    rdfs:label "Aggregate (frequency, majority polarity)" ;
    beam:produce res:aspectTable .

res:t3_prepTrain a beam:Transform ;
    rdfs:label "Paragraph selection + pseudo aspect table (lexicon) + serialization" ;
    beam:produce res:t3_trainInputs .

res:t3_training a beam:Train ;
    rdfs:label "Fine-tuning" ;
    beam:produce res:t3_model .

res:t3_prepInput a beam:Transform ;
    rdfs:label "Paragraph selection + serialization" ;
    beam:produce res:t3_input .

res:t3_inference a beam:Infer ;
    rdfs:label "Generation (beam search)" ;
    beam:produce res:t3_metaReview .

# agents
res:t2_annotator a beam:Agent ;
    rdfs:label "Task 2 author: guideline + manual check" ;
    beam:participatedIn res:t2_annotation .
