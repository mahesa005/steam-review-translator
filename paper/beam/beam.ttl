# BEAM description of the Steam Review Translator (generated by make_beam.py).
# The beam: namespace below is a placeholder: replace it with the one from the course.
@prefix beam: <https://semsys.ai.wu.ac.at/beam/beam_core.ttl#> .
@prefix ex:   <https://example.org/steam-review-translator#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:SteamReviewTranslator a beam:SystemDescription ;
    rdfs:label "Steam Review Translator" ;
    rdfs:comment "Turns a batch of reviews of one game into a sentiment distribution, an aspect table and a meta-review." .

ex:Task1 a beam:Container ;
    rdfs:label "Task 1 -- Batch Sentiment Aggregation" ;
    beam:partOf ex:SteamReviewTranslator .

ex:Task2 a beam:Container ;
    rdfs:label "Task 2 -- Aspect-Based Opinion Mining (sentence-level ABSA)" ;
    beam:partOf ex:SteamReviewTranslator .

ex:Task3 a beam:Container ;
    rdfs:label "Task 3 -- Meta-Review Generation (multi-document summarization)" ;
    beam:partOf ex:SteamReviewTranslator .

ex:batchReviews a beam:Data ;
    rdfs:label "Batch of reviews of one game (input)" ;
    beam:partOf ex:Task1, ex:Task2, ex:Task3 ;
    beam:flowsTo ex:t1_inference, ex:t2_split, ex:t3_prepInput .

ex:t1_trainData a beam:Data ;
    rdfs:label "Metacritic user reviews (train), label from user score" ;
    beam:partOf ex:Task1 ;
    beam:flowsTo ex:t1_training .

ex:t1_training a beam:Training ;
    rdfs:label "Fine-tuning" ;
    beam:partOf ex:Task1 ;
    beam:flowsTo ex:t1_model .

ex:t1_model a beam:StatisticalModel ;
    rdfs:label "RoBERTa-base (S4)" ;
    beam:partOf ex:Task1 ;
    beam:flowsTo ex:t1_inference .

ex:t1_inference a beam:Inference ;
    rdfs:label "Inference (per review)" ;
    beam:partOf ex:Task1 ;
    beam:flowsTo ex:t1_labels .

ex:t1_labels a beam:Symbol ;
    rdfs:label "Sentiment label per review (pos / neg / neu)" ;
    beam:partOf ex:Task1 ;
    beam:flowsTo ex:t1_aggregate .

ex:t1_aggregate a beam:Transformation ;
    rdfs:label "Aggregate (class shares)" ;
    beam:partOf ex:Task1 ;
    beam:flowsTo ex:t1_distribution .

ex:t1_distribution a beam:Symbol ;
    rdfs:label "Sentiment distribution + dominant label (output)" ;
    beam:partOf ex:Task1 .

ex:t2_sample a beam:Data ;
    rdfs:label "Sampled Steam review sentences (7,002; 13 games)" ;
    beam:partOf ex:Task2 ;
    beam:flowsTo ex:t2_annotation .

ex:t2_annotator a beam:Actor ;
    rdfs:label "LLM annotator (Claude) + team guideline" ;
    beam:partOf ex:Task2 ;
    beam:flowsTo ex:t2_annotation .

ex:t2_annotation a beam:Engineering ;
    rdfs:label "Annotation (aspect, polarity)" ;
    beam:partOf ex:Task2 ;
    beam:flowsTo ex:t2_labeled .

ex:t2_labeled a beam:Data ;
    rdfs:label "Labeled sentences (train / val / test by game)" ;
    beam:partOf ex:Task2 ;
    beam:flowsTo ex:t2_training .

ex:t2_training a beam:Training ;
    rdfs:label "LoRA fine-tuning" ;
    beam:partOf ex:Task2 ;
    beam:flowsTo ex:t2_model .

ex:t2_model a beam:StatisticalModel ;
    rdfs:label "RoBERTa-base + LoRA, 11 aspect heads" ;
    beam:partOf ex:Task2 ;
    beam:flowsTo ex:t2_inference .

ex:t2_split a beam:Transformation ;
    rdfs:label "Sentence splitting (spaCy)" ;
    beam:partOf ex:Task2 ;
    beam:flowsTo ex:t2_sentences .

ex:t2_sentences a beam:Data ;
    rdfs:label "Review sentences" ;
    beam:partOf ex:Task2 ;
    beam:flowsTo ex:t2_inference .

ex:t2_inference a beam:Inference ;
    rdfs:label "Inference (per sentence)" ;
    beam:partOf ex:Task2 ;
    beam:flowsTo ex:t2_pairs .

ex:t2_pairs a beam:Symbol ;
    rdfs:label "(aspect, polarity) pairs per sentence" ;
    beam:partOf ex:Task2 ;
    beam:flowsTo ex:t2_aggregate .

ex:t2_aggregate a beam:Transformation ;
    rdfs:label "Aggregate (frequency, majority polarity)" ;
    beam:partOf ex:Task2 ;
    beam:flowsTo ex:aspectTable .

ex:aspectTable a beam:Symbol ;
    rdfs:label "Aspect table: frequency + polarity per aspect (output)" ;
    beam:partOf ex:Task2, ex:Task3 ;
    beam:flowsTo ex:t3_prepInput .

ex:t3_gameWikiSum a beam:Data ;
    rdfs:label "GameWikiSum: game reviews + Wikipedia summaries" ;
    beam:partOf ex:Task3 ;
    beam:flowsTo ex:t3_prepTrain .

ex:t3_prepTrain a beam:Transformation ;
    rdfs:label "Paragraph selection + pseudo aspect table (lexicon) + serialization" ;
    beam:partOf ex:Task3 ;
    beam:flowsTo ex:t3_trainInputs .

ex:t3_trainInputs a beam:Data ;
    rdfs:label "Serialized inputs: aspect prefix + text -> summary" ;
    beam:partOf ex:Task3 ;
    beam:flowsTo ex:t3_training .

ex:t3_training a beam:Training ;
    rdfs:label "Fine-tuning" ;
    beam:partOf ex:Task3 ;
    beam:flowsTo ex:t3_model .

ex:t3_model a beam:StatisticalModel ;
    rdfs:label "BART-base + aspect prefix (E2)" ;
    beam:partOf ex:Task3 ;
    beam:flowsTo ex:t3_inference .

ex:t3_prepInput a beam:Transformation ;
    rdfs:label "Paragraph selection + serialization" ;
    beam:partOf ex:Task3 ;
    beam:flowsTo ex:t3_input .

ex:t3_input a beam:Data ;
    rdfs:label "Aspect prefix + selected review text" ;
    beam:partOf ex:Task3 ;
    beam:flowsTo ex:t3_inference .

ex:t3_inference a beam:Inference ;
    rdfs:label "Generation (beam search)" ;
    beam:partOf ex:Task3 ;
    beam:flowsTo ex:t3_metaReview .

ex:t3_metaReview a beam:Data ;
    rdfs:label "Meta-review (output)" ;
    beam:partOf ex:Task3 .
